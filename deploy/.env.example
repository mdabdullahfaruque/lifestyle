# Copy to deploy/.env on the server and fill in. NEVER commit the filled-in file.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# One .env per country deployment. Same image, different configuration (doc 03 §6.1).

# ── Deployment identity ──────────────────────────────────────────────────────
DEPLOYMENT=my-prod
REGISTRY=ghcr.io/<your-org>
TAG=latest

# ── Country profile ──────────────────────────────────────────────────────────
PLATFORM_COUNTRY=MY
PLATFORM_CURRENCY=MYR
PLATFORM_TIMEZONE=Asia/Kuala_Lumpur
ROOT_DOMAIN=example.com
ACME_EMAIL=ops@example.com

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=lifestyle
POSTGRES_USER=lifestyle
# openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Identity ─────────────────────────────────────────────────────────────────
# Minimum 32 bytes. Rotating this invalidates every access token immediately, which is the
# intended emergency response to a suspected leak.
#   openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_AUDIENCE_BASE=lifestyle

# ── Object storage ───────────────────────────────────────────────────────────
# `local` keeps media on this server: the API writes to a Docker volume and Caddy serves it
# read-only at media.{ROOT_DOMAIN}, cached by Cloudflare. No external storage service involved.
#
# Watch disk usage — vendor media shares the NVMe with the database, and disk is the constraint
# that bites first (doc 03 §7.2). If it grows, switch to `s3` and point these at any
# S3-compatible service; the code needs no change.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_SERVICE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MEDIA_PUBLIC_BASE_URL=https://media.example.com

# ── First administrator ──────────────────────────────────────────────────────
# Read only by `-- seed`. Remove both values from this file once the account exists, and enrol
# it in TOTP immediately — the admin surface refuses a sign-in without it.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Platform Administrator


# ── Host published port (only with deploy/docker-compose.host-nginx.yml) ─────
# Used when this host already runs its own reverse proxy, so our Caddy container is parked.
# API_BIND=127.0.0.1 is correct once a proxy fronts the API. 0.0.0.0 publishes the API to the
# public internet over PLAIN HTTP — acceptable only as an interim state before a domain exists.
API_BIND=127.0.0.1
API_HOST_PORT=5600

# ── Backups ──────────────────────────────────────────────────────────────────
# The copy MUST leave this machine. A backup on the same disk as the data is not a backup
# (doc 03 §10.1) — it survives a dropped table and nothing else.
#
# Configure ONE of the two targets below. Rsync is the zero-new-services option: any second
# machine with SSH — another VPS, an office PC that is on at night — is enough.
#   BACKUP_RSYNC_TARGET=backup@othervps:/srv/backups/lifestyle
# The S3 form accepts any S3-compatible endpoint, if you ever adopt one.
BACKUP_RSYNC_TARGET=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
