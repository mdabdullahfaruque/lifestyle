    "deny": [
      "Bash(ssh:*)",
      "Bash(git push --force:*)",
      "Read(./web/dist/**)",
      "Read(./web/node_modules/**)",
      "Read(./web/.angular/**)",
      "Read(./src/**/bin/**)",
      "Read(./src/**/obj/**)",
      "Read(./tests/**/bin/**)",
      "Read(./tests/**/obj/**)",
      "Read(./**/*.log)"
    ]
  }
