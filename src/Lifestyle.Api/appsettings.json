{
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },

  "Platform": {
    "Country": "MY",
    "Currency": "MYR",
    "RootDomain": "lifestyle.test",
    "TimeZone": "Asia/Kuala_Lumpur",
    "CorsOrigins": []
  },

  "Identity": {
    "JwtIssuer": "https://api.lifestyle.test",
    "JwtAudienceBase": "lifestyle",
    "JwtSigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "MinimumPasswordLength": 10,
    "PasswordResetMinutes": 60,
    "//PasswordResetUrls": "Per-surface landing page for a reset link. A surface with no entry cannot send reset mail — the endpoint says so rather than mailing a dead link. Set per deployment.",
    "PasswordResetUrls": {}
  },

  "//Email": "Blank Host selects the logging sender: nothing is delivered and every message is logged instead. Set these to send real mail; any SMTP provider works.",
  "Email": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@lifestyle.test",
    "FromName": "Lifestyle Mart",
    "TimeoutSeconds": 15
  },

  "//Vendors": "Addresses used in the mail sent when a shop is approved or rejected. ShopUrlTemplate substitutes {slug} — point it at the path form while wildcard subdomains are not yet resolving (docs/07 §10), and at the subdomain form once they are. Blank omits the link rather than sending a dead one.",
  "Vendors": {
    "SellerConsoleUrl": "",
    "ShopUrlTemplate": ""
  },

  "Catalog": {
    "Currency": "MYR",
    "DefaultPageSize": 24,
    "MaxPageSize": 100
  },

  "Media": {
    "MaxUploadBytes": 10485760,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "application/pdf" ],
    "OrphanRetentionHours": 24
  },

  "Storage": {
    "Provider": "local",
    "LocalRoot": ".storage",
    "PublicBaseUrl": "/media"
  },

  "Outbox": {
    "PollSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 8
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
