{
  "name": "lifestyle-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve storefront",
    "build": "ng build storefront && ng build seller && ng build admin",
    "watch": "ng build --watch --configuration development",
    "test": "ng test storefront --watch=false && ng test seller --watch=false && ng test admin --watch=false",
    "serve:ssr:storefront": "node dist/storefront/server/server.mjs",
    "start:seller": "ng serve seller --port 4201",
    "start:admin": "ng serve admin --port 4202",
    "generate:client": "ng-openapi-gen --input ../openapi.json --output projects/data-access/src/lib/generated"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.34",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.34",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.3.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "typescript": "~5.9.2"
  }
}
